# Banco de dados
DATABASE_URL=postgres://crm:crm@localhost:5432/crm_lab

# Cache / filas
REDIS_URL=redis://localhost:6379

# Autenticacao (gerar valores unicos por ambiente — NUNCA commitar o .env)
JWT_SECRET=troque-este-valor-em-producao
JWT_REFRESH_SECRET=troque-este-valor-tambem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Integracao WhatsApp Business API (vazio em dev = driver mock que ecoa)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MINUTE=100
