{
  "name": "@crm-lab/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/backend/src/main.js",
    "build": "tsc -p tsconfig.build.json && npm run build:shared-link",
    "build:shared-link": "node -e \"const fs=require('fs'),p='dist/node_modules/@crm-lab/shared';fs.mkdirSync(p,{recursive:true});fs.writeFileSync(p+'/package.json',JSON.stringify({name:'@crm-lab/shared',type:'module',main:'index.js'}));fs.writeFileSync(p+'/index.js','export * from '+JSON.stringify('../../../shared/types/index.js')+';')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run tests/integration",
    "test:cov": "vitest run --coverage",
    "migrate": "tsx src/db/cli/migrate.ts",
    "seed": "tsx src/db/cli/seed.ts",
    "seed:e2e": "tsx src/db/cli/seed.ts --e2e"
  },
  "dependencies": {
    "@crm-lab/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-type": "^20.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
