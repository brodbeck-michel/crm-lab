[Unit]
Description=Varredura de saude do CRM Lab (containers, disco, reboot, backup)
Documentation=file:///opt/crm-lab/docs/guides/MONITORING.md
After=docker.service
# `Wants`, nao `Requires`: se o Docker estiver fora, e exatamente disso que o
# monitor precisa avisar — a unidade nao pode deixar de rodar por causa disso.
Wants=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/crm-lab
# Destino do alerta (webhook generico) e limiares. Arquivo com 0600, fora do
# repositorio: `ALERT_WEBHOOK_URL` pode carregar token na propria URL.
# Ausente = o monitor roda e registra tudo no journal, sem enviar nada.
EnvironmentFile=-/etc/crm-lab/monitor.env
# systemd cria e gerencia /var/lib/crm-lab-monitor (dono, grupo e permissoes
# certos) na primeira ativacao da unidade — elimina o `sudo install -d`
# manual do passo de instalacao. Se STATE_DIR for sobrescrito no
# monitor.env para outro caminho, ajuste aqui tambem.
StateDirectory=crm-lab-monitor
ExecStart=/opt/crm-lab/scripts/monitora-saude.sh
Nice=10
IOSchedulingClass=idle
